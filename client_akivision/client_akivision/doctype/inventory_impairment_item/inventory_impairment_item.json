  {"fieldname":"basis_rate","fieldtype":"Currency","label":"原始单价","description":"按库存单位和公司本位币填写；不修改库存估值或购销价格。","in_list_view":1,"columns":2},
  {"fieldname":"last_usage_time","fieldtype":"Datetime","label":"最后使用时间","read_only":1,"is_virtual":1,"in_list_view":1,"columns":3},
  {"fieldname":"more_settings","fieldtype":"Section Break","label":"更多设置","collapsible":1},
