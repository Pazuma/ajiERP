  {"fieldname":"impairment_ratio","fieldtype":"Percent","label":"累计减值比例","read_only":1},
  {"fieldname":"impairment_amount","fieldtype":"Currency","label":"跌价准备建议金额","read_only":1},
  {"fieldname":"status","fieldtype":"Select","label":"状态","options":"待评估\n已评估（未计提）\n已计提\n建议转回\n已转回\n异常"},
