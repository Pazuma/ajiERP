  {"fieldname":"metric_code","fieldtype":"Data","label":"指标编码","description":"使用稳定的英文 snake_case 编码；必须与看板 API 和 KPI Target 使用同一编码。","reqd":1,"unique":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"metric_name","fieldtype":"Data","label":"指标名称","reqd":1,"in_list_view":1},
  {"fieldname":"section","fieldtype":"Select","label":"看板分区","options":"销售整体\n订单完成\n回款与应收\n业务员业绩\n同比指标\n对账预警\n应收核心管控\n生产采购运营\n高新收入合规","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"datatype","fieldtype":"Select","label":"数据类型","options":"Int\nFloat\nCurrency\nPercent\nDate","reqd":1,"default":"Float","in_list_view":1},
  {"fieldname":"is_compliance","fieldtype":"Check","label":"合规指标","default":0,"in_list_view":1},
  {"fieldname":"enabled","fieldtype":"Check","label":"启用","default":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"section_source","fieldtype":"Section Break","label":"指标口径"},
  {"fieldname":"source_doctypes","fieldtype":"Small Text","label":"数据来源单据","description":"例如：Sales Order、Delivery Note、Sales Invoice。只登记来源，不保存汇总结果。","reqd":1},
  {"fieldname":"formula","fieldtype":"Long Text","label":"计算公式","description":"使用业务语言描述分子、分母、过滤条件和去重规则。","reqd":1},
  {"fieldname":"filter_scope","fieldtype":"Long Text","label":"统计范围","description":"说明公司、日期、状态、业务员、仓库、项目等筛选条件。","reqd":1},
  {"fieldname":"default_period_type","fieldtype":"Select","label":"默认周期","options":"Monthly\nQuarterly\nYearly\nCustom","reqd":1,"default":"Monthly"},
  {"fieldname":"evaluation_direction","fieldtype":"Select","label":"评价方向","options":"Higher Is Better\nLower Is Better\nInformational","reqd":1,"default":"Informational"},
  {"fieldname":"drilldown_report","fieldtype":"Link","label":"下钻报表","options":"Report","description":"指标卡点击后打开的明细报表；无下钻时可留空。"},
  {"fieldname":"owner_role","fieldtype":"Link","label":"维护角色","options":"Role","description":"负责确认指标口径和维护目标的角色。"},
