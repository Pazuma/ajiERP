 "font_size":10,
 "html":"<style>\n.cf-voucher{font-family:Arial,\"Microsoft YaHei\",sans-serif;color:#111}.cf-voucher h2{text-align:center;margin:0 0 6px;font-size:22px;letter-spacing:0}.cf-meta{width:100%;margin-bottom:8px}.cf-meta td{padding:2px 4px}.cf-lines{width:100%;border-collapse:collapse;table-layout:fixed}.cf-lines th,.cf-lines td{border:1px solid #222;padding:6px 5px;vertical-align:top}.cf-lines th{text-align:center;background:#f3f3f3}.cf-num{text-align:right}.cf-signatures{width:100%;margin-top:14px}.cf-signatures td{width:25%;padding:4px}.cf-hash{margin-top:8px;font-size:8px;color:#555;word-break:break-all}\n</style>\n<div class=\"cf-voucher\">\n<h2>记 账 凭 证</h2>\n<table class=\"cf-meta\"><tr><td><b>公司：</b>{{ doc.company }}</td><td><b>日期：</b>{{ frappe.utils.format_date(doc.posting_date) }}</td><td><b>凭证号：</b>{{ doc.statutory_number }}</td></tr><tr><td><b>来源：</b>{{ _(doc.source_doctype) }} {{ doc.source_name }}</td><td><b>会计期间：</b>{{ doc.accounting_period }}</td><td><b>附件：</b>{{ doc.attachment_count }} 张</td></tr></table>\n<table class=\"cf-lines\"><thead><tr><th style=\"width:27%\">摘要</th><th style=\"width:31%\">会计科目</th><th style=\"width:21%\">借方金额</th><th style=\"width:21%\">贷方金额</th></tr></thead><tbody>{% for row in doc.entries %}<tr><td>{{ row.remarks or doc.remarks or \"\" }}</td><td>{{ row.account }}{% if row.party %}<br><small>{{ row.party_type }}：{{ row.party }}</small>{% endif %}{% if row.cost_center %}<br><small>成本中心：{{ row.cost_center }}</small>{% endif %}</td><td class=\"cf-num\">{{ row.get_formatted(\"debit\", doc) if row.debit else \"\" }}</td><td class=\"cf-num\">{{ row.get_formatted(\"credit\", doc) if row.credit else \"\" }}</td></tr>{% endfor %}<tr><td colspan=\"2\" style=\"text-align:center\"><b>合计</b></td><td class=\"cf-num\"><b>{{ doc.get_formatted(\"total_debit\") }}</b></td><td class=\"cf-num\"><b>{{ doc.get_formatted(\"total_credit\") }}</b></td></tr></tbody></table>\n<table class=\"cf-signatures\"><tr><td><b>制单：</b>{{ doc.prepared_by or \"\" }}</td><td><b>审核：</b>{{ doc.reviewed_by or \"\" }}</td><td><b>记账：</b>{{ doc.posted_by or \"\" }}</td><td><b>凭证字：</b>{{ doc.voucher_word }}</td></tr></table>\n<div class=\"cf-hash\">分录校验值：{{ doc.source_hash }}</div>\n</div>",
